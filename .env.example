# MongoDB Atlas connection string (replica-set enabled, required for Prisma transactions)
DATABASE_URL=

# BMONI Embedded sandbox — origin only, no /v1 suffix
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=

# Encrypts each provisioned wallet's owner private key at rest
KEY_ENCRYPTION_SECRET=

# Signs the session cookie
JWT_SECRET=

# Duey's chat completions provider
AI_API_KEY=

# Bridge between the Next.js app and the always-on WhatsApp worker (worker/whatsapp-bot.ts)
WHATSAPP_WORKER_URL=http://localhost:8787
WHATSAPP_WORKER_SECRET=

# Gate for /admin
ADMIN_SECRET=
